# Copy to .env and fill in real values. Never commit the real .env file.

# --- Backend ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=changeme-generate-a-real-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/person_id_platform

# --- Object storage (MinIO locally / S3-compatible in prod) ---
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=face-platform-photos

# --- AI service ---
AI_SERVICE_URL=http://ai:8100
AI_SERVICE_INTERNAL_TOKEN=changeme-generate-a-real-secret

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite exposes only VITE_-prefixed vars) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
